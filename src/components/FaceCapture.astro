---
// FaceCapture component — auto-captures face photos using MediaPipe FaceLandmarker
// Storage: localStorage (no database needed)
---

<!-- Start screen -->
<div id="start-screen">
  <div class="start-content">
    <div class="start-title">FACE<br />CAPTURE</div>
    <p class="start-sub">
      Alineá tu rostro dentro del óvalo.<br />
      La foto se toma automáticamente.
    </p>
    <div class="name-input-group">
      <label for="person-name" class="name-label">Nombre de la persona</label>
      <input type="text" id="person-name" class="name-input" placeholder="Ej: Juan Pérez" autocomplete="off" />
    </div>
    <button class="start-btn" id="start-btn">Iniciar cámara</button>
    <div class="loading-bar" id="loading-bar">
      <div class="loading-bar-fill"></div>
    </div>
  </div>
</div>

<!-- Header -->
<header>
  <div class="logo">FACE<span>CAPTURE</span></div>
  <div class="header-right">
    <a href="/compare" class="nav-btn">Comparar rostros</a>
    <div class="status-pill" id="status-pill">
      <div class="status-dot"></div>
      <span id="status-text">INACTIVO</span>
    </div>
  </div>
</header>

<!-- Main -->
<main>
  <div class="camera-area">
    <div class="viewport" id="viewport">
      <video id="video" autoplay muted playsinline></video>
      <canvas id="canvas"></canvas>
      <div class="face-guide">
        <div class="face-oval" id="face-oval">
          <div class="bracket tl"></div>
          <div class="bracket tr"></div>
          <div class="bracket bl"></div>
          <div class="bracket br"></div>
          <svg class="progress-ring" id="progress-ring"
