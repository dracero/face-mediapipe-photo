---
// FaceCapture component — auto-captures face photos using MediaPipe FaceLandmarker
---

<!-- Start screen -->
<div id="start-screen">
  <div class="start-content">
    <div class="start-title">FACE<br />CAPTURE</div>
    <p class="start-sub">
      Alineá tu rostro dentro del óvalo.<br />
      La foto se toma automáticamente.
    </p>
    <div class="name-input-group">
      <label for="person-name" class="name-label">Nombre de la persona</label>
      <input type="text" id="person-name" class="name-input" placeholder="Ej: Juan Pérez" autocomplete="off" />
    </div>
    <button class="start-btn" id="start-btn">Iniciar cámara</button>
    <div class="loading-bar" id="loading-bar">
      <div class="loading-bar-fill"></div>
    </div>
  </div>
</div>

<!-- Header -->
<header>
  <div class="logo">FACE<span>CAPTURE</span></div>
  <div class="header-right">
    <a href="/compare" class="nav-btn">Comparar rostros</a>
    <div class="status-pill" id="status-pill">
    <div class="status-dot"></div>
    <span id="status-text">INACTIVO</span>
    </div>
  </div>
</header>

<!-- Main -->
<main>
  <div class="camera-area">
    <div class="viewport" id="viewport">
      <video id="video" autoplay muted playsinline></video>
      <canvas id="canvas"></canvas>
      <div class="face-guide">
        <div class="face-oval" id="face-oval">
          <div class="bracket tl"></div>
          <div class="bracket tr"></div>
          <div class="bracket bl"></div>
          <div class="bracket br"></div>
          <svg class="progress-ring" id="progress-ring" viewBox="0 0 110 110">
            <circle id="ring-circle" cx="55" cy="55" r="52" stroke-dasharray="326.7" stroke-dashoffset="326.7"></circle>
          </svg>
        </div>
      </div>
      <div id="countdown"><div class="countdown-num" id="countdown-num"></div></div>
      <div id="flash"></div>
      <div class="instructions" id="instructions">ESPERANDO CÁMARA…</div>
    </div>
  </div>

  <div class="sidebar">
    <div class="sidebar-header">
      <div class="sidebar-title">Fotos</div>
      <div class="photo-count" id="photo-count">0</div>
    </div>
    <div class="gallery" id="gallery">
      <div class="empty-state">
        <span class="icon">◎</span>
        Alineá tu rostro para<br />tomar la primera foto
      </div>
    </div>
    <div class="metrics">
      <div class="metric">
        <span class="metric-label">CENTRADO</span>
        <div class="metric-bar"><div class="metric-bar-fill" id="bar-center" style="width:0%"></div></div>
        <span class="metric-val" id="val-center">—</span>
      </div>
      <div class="metric">
        <span class="metric-label">TAMAÑO</span>
        <div class="metric-bar"><div class="metric-bar-fill" id="bar-size" style="width:0%"></div></div>
        <span class="metric-val" id="val-size">—</span>
      </div>
      <div class="metric">
        <span class="metric-label">FOTOS</span>
        <div class="metric-bar"><div class="metric-bar-fill" id="bar-photos" style="width:0%"></div></div>
        <span class="metric-val" id="val-photos">0/10</span>
      </div>
    </div>
  </div>
</main>

<!-- Photo modal -->
<div id="photo-modal">
  <img id="modal-img" src="" alt="Foto" />
</div>

<style>
  /* ── Layout ─────────────────────────────────────────────────────────── */
  header {
    position: fixed;
    top: 0; left: 0; right: 0;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 24px;
    background: rgba(10,10,10,0.85);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid #1f1f1f;
    z-index: 10;
  }

  .logo {
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    font-size: 18px;
    letter-spacing: 0.08em;
    color: #fff;
  }
  .logo span { color: #00ff88; }

  .header-right {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .nav-btn {
    padding: 6px 14px;
    background: rgba(0,255,136,0.1);
    border: 1px solid rgba(0,255,136,0.3);
    color: #00ff88;
    font-family: 'DM Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.06em;
    border-radius: 100px;
    text-decoration: none;
    transition: background 0.2s, border-color 0.2s;
  }
  .nav-btn:hover {
    background: rgba(0,255,136,0.2);
    border-color: rgba(0,255,136,0.5);
  }

  main {
    display: flex;
    height: 100vh;
    padding-top: 56px;
  }

  /* ── Status pill ─────────────────────────────────────────────────────── */
  .status-pill {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: 100px;
    background: #141414;
    border: 1px solid #2a2a2a;
    font-size: 11px;
    letter-spacing: 0.1em;
    transition: border-color 0.3s, background 0.3s;
  }
  .status-pill.detecting { border-color: #f59e0b40; background: #1a1500; }
  .status-pill.aligned   { border-color: #00ff8840; background: #001a0e; }
  .status-pill.capturing { border-color: #3b82f640; background: #00091a; }

  .status-dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: #555;
    transition: background 0.3s;
  }
  .status-pill.detecting .status-dot { background: #f59e0b; box-shadow: 0 0 6px #f59e0b; }
  .status-pill.aligned   .status-dot { background: #00ff88; box-shadow: 0 0 6px #00ff88; }
  .status-pill.capturing .status-dot { background: #3b82f6; box-shadow: 0 0 6px #3b82f6; }

  /* ── Camera area ─────────────────────────────────────────────────────── */
  .camera-area {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #0d0d0d;
    position: relative;
    overflow: hidden;
  }

  .viewport {
    position: relative;
    width: 640px;
    max-width: 100%;
    aspect-ratio: 4/3;
  }

  #video {
    width: 100%; height: 100%;
    object-fit: cover;
    transform: scaleX(-1);
    border-radius: 12px;
    display: block;
  }

  #canvas {
    position: absolute;
    inset: 0;
    width: 100%; height: 100%;
    transform: scaleX(-1);
    border-radius: 12px;
    pointer-events: none;
  }

  /* ── Face guide ──────────────────────────────────────────────────────── */
  .face-guide {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .face-oval {
    position: relative;
    width: 220px;
    height: 290px;
    border-radius: 50%;
    border: 2px solid rgba(255,255,255,0.2);
    transition: border-color 0.3s, box-shadow 0.3s;
  }
  .face-oval.detecting { border-color: rgba(245,158,11,0.5); box-shadow: 0 0 0 1px rgba(245,158,11,0.2) inset; }
  .face-oval.aligned   { border-color: rgba(0,255,136,0.7); box-shadow: 0 0 20px rgba(0,255,136,0.2) inset, 0 0 40px rgba(0,255,136,0.1); }

  /* Corner brackets */
  .bracket {
    position: absolute;
    width: 18px; height: 18px;
    border-color: #00ff88;
    border-style: solid;
  }
  .bracket.tl { top: -2px; left: -2px;  border-width: 2px 0 0 2px; border-radius: 3px 0 0 0; }
  .bracket.tr { top: -2px; right: -2px; border-width: 2px 2px 0 0; border-radius: 0 3px 0 0; }
  .bracket.bl { bottom: -2px; left: -2px;  border-width: 0 0 2px 2px; border-radius: 0 0 0 3px; }
  .bracket.br { bottom: -2px; right: -2px; border-width: 0 2px 2px 0; border-radius: 0 0 3px 0; }

  /* Progress ring */
  .progress-ring {
    position: absolute;
    inset: -4px;
    width: calc(100% + 8px);
    height: calc(100% + 8px);
    transform: rotate(-90deg);
    pointer-events: none;
    overflow: visible;
  }
  #ring-circle {
    fill: none;
    stroke: #00ff88;
    stroke-width: 3;
    stroke-linecap: round;
    transition: stroke-dashoffset 0.1s linear;
    filter: drop-shadow(0 0 4px #00ff88);
  }

  /* ── Flash ───────────────────────────────────────────────────────────── */
  #flash {
    position: absolute;
    inset: 0;
    background: #fff;
    opacity: 0;
    border-radius: 12px;
    pointer-events: none;
    transition: opacity 0.08s;
  }
  #flash.active { opacity: 0.85; }

  /* ── Instructions ────────────────────────────────────────────────────── */
  .instructions {
    position: absolute;
    bottom: 16px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(10,10,10,0.75);
    backdrop-filter: blur(8px);
    border: 1px solid #2a2a2a;
    padding: 8px 16px;
    border-radius: 100px;
    font-size: 11px;
    letter-spacing: 0.12em;
    white-space: nowrap;
    color: #aaa;
    transition: color 0.3s, border-color 0.3s;
  }
  .instructions.aligned-text { color: #00ff88; border-color: rgba(0,255,136,0.4); }

  /* ── Sidebar ─────────────────────────────────────────────────────────── */
  .sidebar {
    width: 300px;
    min-width: 260px;
    background: #0d0d0d;
    border-left: 1px solid #1a1a1a;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .sidebar-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 20px 12px;
    border-bottom: 1px solid #1a1a1a;
  }

  .sidebar-title {
    font-family: 'Syne', sans-serif;
    font-weight: 700;
    font-size: 15px;
    letter-spacing: 0.04em;
  }

  .photo-count {
    background: #1a1a1a;
    border: 1px solid #2a2a2a;
    padding: 3px 10px;
    border-radius: 100px;
    font-size: 12px;
    color: #888;
  }

  /* Gallery */
  .gallery {
    flex: 1;
    overflow-y: auto;
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    scrollbar-width: thin;
    scrollbar-color: #2a2a2a transparent;
  }

  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    height: 100%;
    color: #444;
    font-size: 12px;
    text-align: center;
    line-height: 1.6;
  }
  .empty-state .icon { font-size: 28px; color: #333; }

  .gallery-item {
    position: relative;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid #1f1f1f;
    cursor: pointer;
    transition: border-color 0.2s, transform 0.2s;
  }
  .gallery-item:hover { border-color: #00ff8840; transform: scale(1.01); }
  .gallery-item img { width: 100%; display: block; aspect-ratio: 4/3; object-fit: cover; }

  .gallery-item .ts {
    position: absolute;
    bottom: 30px; left: 8px;
    background: rgba(0,0,0,0.65);
    font-size: 10px;
    color: #888;
    padding: 2px 6px;
    border-radius: 4px;
  }

  .gallery-item .dl-btn {
    position: absolute;
    bottom: 8px; right: 8px;
    background: rgba(0,255,136,0.15);
    border: 1px solid rgba(0,255,136,0.3);
    color: #00ff88;
    font-size: 10px;
    font-family: 'DM Mono', monospace;
    letter-spacing: 0.05em;
    padding: 3px 8px;
    border-radius: 4px;
    text-decoration: none;
    transition: background 0.2s;
  }
  .gallery-item .dl-btn:hover { background: rgba(0,255,136,0.3); }

  /* ── Metrics ─────────────────────────────────────────────────────────── */
  .metrics {
    padding: 16px 20px;
    border-top: 1px solid #1a1a1a;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .metric {
    display: grid;
    grid-template-columns: 72px 1fr 36px;
    align-items: center;
    gap: 10px;
  }
  .metric-label { font-size: 9px; letter-spacing: 0.12em; color: #555; }
  .metric-bar {
    height: 3px;
    background: #1f1f1f;
    border-radius: 2px;
    overflow: hidden;
  }
  .metric-bar-fill {
    height: 100%;
    background: linear-gradient(90deg, #00ff88, #00e5ff);
    border-radius: 2px;
    transition: width 0.2s;
  }
  .metric-val { font-size: 10px; color: #666; text-align: right; }

  /* ── Start screen ────────────────────────────────────────────────────── */
  #start-screen {
    position: fixed;
    inset: 0;
    background: #0a0a0a;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 100;
    transition: opacity 0.4s;
  }

  .start-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    text-align: center;
    padding: 40px;
  }

  .start-title {
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    font-size: clamp(48px, 10vw, 96px);
    letter-spacing: -0.02em;
    line-height: 0.9;
    color: #fff;
  }

  .start-sub {
    font-size: 13px;
    color: #666;
    line-height: 1.7;
    letter-spacing: 0.03em;
  }

  .name-input-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
    width: 280px;
  }
  .name-label {
    font-size: 10px;
    letter-spacing: 0.1em;
    color: #555;
    text-align: left;
  }
  .name-input {
    background: #141414;
    border: 1px solid #2a2a2a;
    border-radius: 8px;
    padding: 12px 16px;
    color: #e8e8e8;
    font-family: 'DM Mono', monospace;
    font-size: 13px;
    outline: none;
    transition: border-color 0.2s;
  }
  .name-input:focus { border-color: #00ff88; }
  .name-input::placeholder { color: #444; }

  .start-btn {
    margin-top: 8px;
    padding: 14px 36px;
    background: #00ff88;
    color: #000;
    font-family: 'DM Mono', monospace;
    font-weight: 500;
    font-size: 13px;
    letter-spacing: 0.08em;
    border: none;
    border-radius: 100px;
    cursor: pointer;
    transition: opacity 0.2s, transform 0.2s;
  }
  .start-btn:hover:not(:disabled) { opacity: 0.85; transform: scale(1.03); }
  .start-btn:disabled { opacity: 0.5; cursor: not-allowed; }

  .loading-bar {
    width: 200px;
    height: 2px;
    background: #1f1f1f;
    border-radius: 2px;
    overflow: hidden;
    opacity: 0;
    transition: opacity 0.3s;
  }
  .loading-bar.show { opacity: 1; }
  .loading-bar-fill {
    height: 100%;
    background: #00ff88;
    border-radius: 2px;
    animation: loadBar 2s ease-in-out infinite;
  }
  @keyframes loadBar {
    0%   { width: 0%; margin-left: 0%; }
    50%  { width: 60%; margin-left: 20%; }
    100% { width: 0%; margin-left: 100%; }
  }

  /* ── Photo modal ─────────────────────────────────────────────────────── */
  #photo-modal {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.9);
    align-items: center;
    justify-content: center;
    z-index: 200;
    cursor: pointer;
  }
  #photo-modal.open { display: flex; }
  #modal-img {
    max-width: 90vw;
    max-height: 90vh;
    border-radius: 12px;
    box-shadow: 0 0 60px rgba(0,0,0,0.8);
  }

  /* ── Countdown ───────────────────────────────────────────────────────── */
  #countdown {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }
  .countdown-num {
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    font-size: 96px;
    color: #fff;
    text-shadow: 0 0 40px rgba(0,255,136,0.6);
    opacity: 0;
  }

  /* ── Save indicator ──────────────────────────────────────────────────── */
  .save-indicator {
    position: absolute;
    top: 12px;
    right: 12px;
    padding: 4px 10px;
    border-radius: 100px;
    font-size: 10px;
    letter-spacing: 0.08em;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s;
  }
  .save-indicator.saving {
    opacity: 1;
    background: rgba(59,130,246,0.2);
    border: 1px solid rgba(59,130,246,0.4);
    color: #3b82f6;
  }
  .save-indicator.saved {
    opacity: 1;
    background: rgba(0,255,136,0.15);
    border: 1px solid rgba(0,255,136,0.3);
    color: #00ff88;
  }

  /* ── Responsive ──────────────────────────────────────────────────────── */
  @media (max-width: 768px) {
    main { flex-direction: column; overflow-y: auto; }
    .sidebar { width: 100%; min-width: unset; border-left: none; border-top: 1px solid #1a1a1a; }
    .camera-area { min-height: 50vh; }
    .header-right { gap: 8px; }
    .nav-btn { font-size: 10px; padding: 5px 10px; }
  }
</style>

<script type="module">
import {
  FaceLandmarker,
  FilesetResolver,
  DrawingUtils
} from 'https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.18/+esm';
import { supabase } from '../lib/supabase';

const video       = document.getElementById('video');
const canvas      = document.getElementById('canvas');
const ctx         = canvas.getContext('2d');
const faceOval    = document.getElementById('face-oval');
const statusPill  = document.getElementById('status-pill');
const statusText  = document.getElementById('status-text');
const instructions = document.getElementById('instructions');
const flash       = document.getElementById('flash');
const gallery     = document.getElementById('gallery');
const photoCount  = document.getElementById('photo-count');
const ringCircle  = document.getElementById('ring-circle');
const RING_CIRC   = 326.7;

let faceLandmarker = null;
let animFrame      = null;
let alignedSince   = null;
let photosTaken    = 0;
let isCoolingDown  = false;
let lastVideoTime  = -1;
let personId       = null;
let personName     = '';

const ALIGN_HOLD_MS = 1200;
const COOLDOWN_MS   = 3000;
const MAX_PHOTOS    = 10;

// ── Init ──────────────────────────────────────────────────────────────────────
document.getElementById('start-btn').addEventListener('click', async () => {
  const nameInput = document.getElementById('person-name');
  personName = nameInput.value.trim();

  if (!personName) {
    nameInput.style.borderColor = '#ef4444';
    nameInput.focus();
    setTimeout(() => { nameInput.style.borderColor = ''; }, 1500);
    return;
  }

  const btn = document.getElementById('start-btn');
  const bar = document.getElementById('loading-bar');
  btn.disabled = true;
  btn.textContent = 'Cargando modelo…';
  bar.classList.add('show');

  try {
    // Create person in DB
    const { data: person, error: personErr } = await supabase
      .from('people')
      .insert({ name: personName })
      .select()
      .maybeSingle();

    if (personErr || !person) throw new Error('Error guardando persona: ' + (personErr?.message || ''));

    personId = person.id;

    await startCamera();
    await loadModel();
    const screen = document.getElementById('start-screen');
    screen.style.opacity = '0';
    setTimeout(() => { screen.style.display = 'none'; }, 400);
    setStatus('detecting', 'BUSCANDO ROSTRO');
    instructions.textContent = 'CENTRÁ TU ROSTRO EN EL ÓVALO';
    detect();
  } catch (e) {
    btn.textContent = 'Error. Reintentar';
    btn.disabled = false;
    bar.classList.remove('show');
    console.error(e);
  }
});

async function startCamera() {
  const stream = await navigator.mediaDevices.getUserMedia({
    video: { width: 640, height: 480, facingMode: 'user' }
  });
  video.srcObject = stream;
  await new Promise(r => { video.onloadedmetadata = r; });
  await video.play();
}

async function loadModel() {
  const vision = await FilesetResolver.forVisionTasks(
    'https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.18/wasm'
  );
  faceLandmarker = await FaceLandmarker.createFromOptions(vision, {
    baseOptions: {
      modelAssetPath: 'https://storage.googleapis.com/mediapipe-models/face_landmarker/face_landmarker/float16/1/face_landmarker.task',
      delegate: 'GPU'
    },
    runningMode: 'VIDEO',
    numFaces: 1,
    minFaceDetectionConfidence: 0.5,
    minFacePresenceConfidence: 0.5,
    minTrackingConfidence: 0.5,
  });
}

// ── Detection loop ────────────────────────────────────────────────────────────
function detect() {
  animFrame = requestAnimationFrame(detect);
  if (video.readyState < 2) return;

  const now = performance.now();
  if (video.currentTime === lastVideoTime) return;
  lastVideoTime = video.currentTime;

  canvas.width  = video.videoWidth;
  canvas.height = video.videoHeight;

  const result = faceLandmarker.detectForVideo(video, now);
  ctx.clearRect(0, 0, canvas.width, canvas.height);

  if (!result.faceLandmarks || result.faceLandmarks.length === 0) {
    onNoFace();
    return;
  }

  const landmarks = result.faceLandmarks[0];
  const drawUtils = new DrawingUtils(ctx);

  drawUtils.drawConnectors(landmarks, FaceLandmarker.FACE_LANDMARKS_TESSELATION, {
    color: '#ffffff08', lineWidth: 0.5
  });
  drawUtils.drawConnectors(landmarks, FaceLandmarker.FACE_LANDMARKS_FACE_OVAL, {
    color: '#00ff8840', lineWidth: 1
  });

  const { centered, sizeOk, score } = checkAlignment(landmarks);
  updateMetrics(landmarks, centered, sizeOk);

  if (centered && sizeOk) {
    onAligned(now, score);
  } else {
    onMisaligned();
    instructions.textContent = getHint(landmarks);
    instructions.classList.remove('aligned-text');
  }
}

function checkAlignment(landmarks) {
  const xs = landmarks.map(l => l.x);
  const ys = landmarks.map(l => l.y);
  const minX = Math.min(...xs), maxX = Math.max(...xs);
  const minY = Math.min(...ys), maxY = Math.max(...ys);
  const cx = (minX + maxX) / 2;
  const cy = (minY + maxY) / 2;
  const w  = maxX - minX;

  const centerScore = 1 - Math.sqrt((cx - 0.5) ** 2 + (cy - 0.48) ** 2) * 4;
  const centered = Math.abs(cx - 0.5) < 0.12 && Math.abs(cy - 0.48) < 0.12;
  const sizeScore = w > 0.28 && w < 0.65 ? 1 - Math.abs(w - 0.42) * 3 : 0;
  const sizeOk = w > 0.28 && w < 0.65;
  const score = (Math.max(0, centerScore) + Math.max(0, sizeScore)) / 2;
  return { centered, sizeOk, score, cx, cy, w };
}

function getHint(landmarks) {
  const xs = landmarks.map(l => l.x);
  const ys = landmarks.map(l => l.y);
  const cx = (Math.min(...xs) + Math.max(...xs)) / 2;
  const cy = (Math.min(...ys) + Math.max(...ys)) / 2;
  const w  = Math.max(...xs) - Math.min(...xs);

  if (w < 0.28)  return 'ACERCATE A LA CÁMARA';
  if (w > 0.65)  return 'ALEJATE UN POCO';
  if (cx < 0.38) return 'MOVETE HACIA LA DERECHA';
  if (cx > 0.62) return 'MOVETE HACIA LA IZQUIERDA';
  if (cy < 0.36) return 'BAJÁ UN POCO';
  if (cy > 0.6)  return 'SUBÍ UN POCO';
  return 'CASI… AJUSTÁ LA POSICIÓN';
}

function updateMetrics(landmarks, centered, sizeOk) {
  const xs = landmarks.map(l => l.x);
  const ys = landmarks.map(l => l.y);
  const w  = Math.max(...xs) - Math.min(...xs);
  const cx = (Math.min(...xs) + Math.max(...xs)) / 2;
  const cy = (Math.min(...ys) + Math.max(...ys)) / 2;

  const centerPct = Math.max(0, Math.min(100,
    100 - Math.sqrt((cx - 0.5) ** 2 + (cy - 0.48) ** 2) * 400
  ));
  const sizePct = w < 0.28
    ? (w / 0.28) * 60
    : w > 0.65
      ? Math.max(0, 100 - (w - 0.65) * 200)
      : 60 + (1 - Math.abs(w - 0.42) / 0.23) * 40;

  document.getElementById('bar-center').style.width = centerPct + '%';
  document.getElementById('val-center').textContent = Math.round(centerPct) + '%';
  document.getElementById('bar-size').style.width   = Math.min(100, sizePct) + '%';
  document.getElementById('val-size').textContent   = Math.round(sizePct) + '%';
}

// ── State handlers ────────────────────────────────────────────────────────────
function onNoFace() {
  alignedSince = null;
  faceOval.className = 'face-oval';
  setRing(0);
  setStatus('detecting', 'BUSCANDO ROSTRO');
  instructions.textContent = 'MIRÁ A LA CÁMARA';
  instructions.classList.remove('aligned-text');
}

function onMisaligned() {
  if (!isCoolingDown) {
    alignedSince = null;
    faceOval.className = 'face-oval detecting';
    setRing(0);
    setStatus('detecting', 'AJUSTANDO');
  }
}

function onAligned(now, score) {
  if (isCoolingDown || photosTaken >= MAX_PHOTOS) return;

  faceOval.className = 'face-oval aligned';
  setStatus('aligned', 'ROSTRO ALINEADO');
  instructions.textContent = '✓ MANTENÉ LA POSICIÓN';
  instructions.classList.add('aligned-text');

  if (!alignedSince) alignedSince = now;
  const elapsed  = now - alignedSince;
  const progress = Math.min(elapsed / ALIGN_HOLD_MS, 1);
  setRing(progress);

  if (elapsed >= ALIGN_HOLD_MS) takePhoto();
}

// ── Photo capture ─────────────────────────────────────────────────────────────
async function takePhoto() {
  if (isCoolingDown) return;
  isCoolingDown = true;
  alignedSince  = null;
  setRing(0);

  setStatus('capturing', 'CAPTURANDO');
  flash.classList.add('active');
  await wait(80);
  flash.classList.remove('active');

  const snap = document.createElement('canvas');
  snap.width  = video.videoWidth;
  snap.height = video.videoHeight;
  const sCtx  = snap.getContext('2d');
  sCtx.translate(snap.width, 0);
  sCtx.scale(-1, 1);
  sCtx.drawImage(video, 0, 0);

  const dataUrl = snap.toDataURL('image/jpeg', 0.92);
  photosTaken++;
  addToGallery(dataUrl);

  // Save to Supabase
  showSaveIndicator('saving');
  const { error } = await supabase
    .from('face_photos')
    .insert({ person_id: personId, photo_data: dataUrl });

  if (error) {
    console.error('Error saving photo:', error);
    showSaveIndicator('error');
  } else {
    showSaveIndicator('saved');
  }

  document.getElementById('bar-photos').style.width = (photosTaken / MAX_PHOTOS * 100) + '%';
  document.getElementById('val-photos').textContent = `${photosTaken}/${MAX_PHOTOS}`;

  await wait(COOLDOWN_MS);
  isCoolingDown = false;

  if (photosTaken >= MAX_PHOTOS) {
    setStatus('aligned', `${MAX_PHOTOS} FOTOS TOMADAS`);
    instructions.textContent = `COMPLETADO — ${MAX_PHOTOS} FOTOS`;
    cancelAnimationFrame(animFrame);
    return;
  }

  setStatus('detecting', 'BUSCANDO ROSTRO');
  faceOval.className = 'face-oval';
  instructions.classList.remove('aligned-text');
}

function addToGallery(dataUrl) {
  const empty = gallery.querySelector('.empty-state');
  if (empty) empty.remove();

  const ts   = new Date().toLocaleTimeString('es-AR', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
  const item = document.createElement('div');
  item.className = 'gallery-item';
  item.innerHTML = `
    <img src="${dataUrl}" alt="Foto ${photosTaken}">
    <span class="ts">${ts}</span>
    <a class="dl-btn" href="${dataUrl}" download="face-${Date.now()}.jpg">↓ DL</a>
  `;
  item.querySelector('img').addEventListener('click', (e) => {
    e.stopPropagation();
    document.getElementById('modal-img').src = dataUrl;
    document.getElementById('photo-modal').classList.add('open');
  });
  gallery.prepend(item);
  photoCount.textContent = photosTaken;
}

// ── Save indicator ────────────────────────────────────────────────────────────
function showSaveIndicator(state) {
  let indicator = document.querySelector('.save-indicator');
  if (!indicator) {
    indicator = document.createElement('div');
    indicator.className = 'save-indicator';
    document.getElementById('viewport').appendChild(indicator);
  }

  if (state === 'saving') {
    indicator.className = 'save-indicator saving';
    indicator.textContent = 'GUARDANDO…';
  } else if (state === 'saved') {
    indicator.className = 'save-indicator saved';
    indicator.textContent = 'GUARDADO';
    setTimeout(() => { indicator.className = 'save-indicator'; }, 2000);
  } else {
    indicator.className = 'save-indicator saving';
    indicator.textContent = 'ERROR';
    indicator.style.color = '#ef4444';
    indicator.style.borderColor = 'rgba(239,68,68,0.4)';
    indicator.style.background = 'rgba(239,68,68,0.15)';
    setTimeout(() => { indicator.className = 'save-indicator'; indicator.style.cssText = ''; }, 3000);
  }
}

// ── Helpers ───────────────────────────────────────────────────────────────────
function setStatus(state, text) {
  statusPill.className = 'status-pill ' + state;
  statusText.textContent = text;
}

function setRing(progress) {
  ringCircle.style.strokeDashoffset = RING_CIRC * (1 - progress);
}

function wait(ms) { return new Promise(r => setTimeout(r, ms)); }

document.getElementById('photo-modal').addEventListener('click', function () {
  this.classList.remove('open');
});
</script>
