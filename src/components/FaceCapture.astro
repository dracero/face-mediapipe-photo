---
// FaceCapture — DeepFace backend + MongoDB
---

<div id="start-screen">
  <div class="start-content">
    <div class="start-title">FACE<br/>CAPTURE</div>
    <p class="start-sub">Alineá tu rostro con los ojos abiertos y la boca cerrada.<br/>La foto se toma automáticamente cuando estés listo.</p>
    <div class="name-input-group">
      <label for="person-name" class="name-label">Nombre de la persona</label>
      <input type="text" id="person-name" class="name-input" placeholder="Ej: Juan Pérez" autocomplete="off"/>
    </div>
    <button class="start-btn" id="start-btn">Iniciar cámara</button>
    <div class="loading-bar" id="loading-bar"><div class="loading-bar-fill"></div></div>
  </div>
</div>

<header>
  <div class="logo">FACE<span>CAPTURE</span></div>
  <div class="header-right">
    <button class="nav-btn" id="collection-btn">📷 Colección</button>
    <div class="status-pill" id="status-pill">
      <div class="status-dot"></div>
      <span id="status-text">INACTIVO</span>
    </div>
  </div>
</header>

<main>
  <div class="camera-area">
    <div class="viewport" id="viewport">
      <video id="video" autoplay muted playsinline></video>
      <canvas id="canvas" style="display:none;"></canvas>
      <div class="face-guide">
        <div class="face-oval" id="face-oval">
          <div class="bracket tl"></div><div class="bracket tr"></div>
          <div class="bracket bl"></div><div class="bracket br"></div>
        </div>
        <div class="face-status" id="face-status">Posicioná tu rostro</div>
      </div>
      <button class="capture-btn" id="capture-btn" disabled aria-label="Tomar foto">
        <span class="capture-btn-icon">◎</span>
        <span class="capture-btn-label">Tomar foto</span>
      </button>
    </div>
    <div class="controls">
      <div class="capture-info">
        <div class="info-title">Captura con DeepFace</div>
        <div class="info-desc">Mirá a la cámara con los ojos abiertos y la boca cerrada.<br/>El botón se activa cuando tu rostro está listo.</div>
      </div>
      <div class="indicators" id="indicators">
        <div class="indicator" id="ind-face"><span class="ind-dot"></span>Rostro</div>
        <div class="indicator" id="ind-eyes"><span class="ind-dot"></span>Ojos abiertos</div>
        <div class="indicator" id="ind-mouth"><span class="ind-dot"></span>Boca cerrada</div>
      </div>
    </div>
  </div>
</main>

<!-- Modal Colección -->
<div class="modal-overlay" id="modal-overlay">
  <div class="modal">
    <div class="modal-header">
      <h2>Colección de fotos</h2>
      <button class="modal-close" id="modal-close">✕</button>
    </div>
    <div class="modal-body" id="modal-body">
      <div class="empty-state"><span class="icon">◎</span>No hay fotos aún</div>
    </div>
  </div>
</div>

<!-- Modal Ampliar -->
<div class="lightbox-overlay" id="lightbox-overlay">
  <button class="lb-close" id="lb-close">✕</button>
  <button class="lb-nav lb-prev" id="lb-prev">‹</button>
  <button class="lb-nav lb-next" id="lb-next">›</button>
  <div class="lb-content">
    <img id="lb-img" src="" alt="Foto ampliada"/>
    <div class="lb-info" id="lb-info"></div>
  </div>
  <button class="lb-delete" id="lb-delete">🗑 Eliminar</button>
</div>

<style>
*{box-sizing:border-box}
body{margin:0;font-family:'DM Mono',monospace;background:#0a0a0a;color:#e8e8e8;overflow:hidden}

#start-screen{position:fixed;inset:0;background:#0a0a0a;display:flex;align-items:center;justify-content:center;z-index:100}
.start-content{text-align:center;max-width:420px;padding:0 24px}
.start-title{font-family:'Syne',sans-serif;font-weight:800;font-size:48px;line-height:.9;letter-spacing:.08em;color:#fff;margin-bottom:24px}
.start-sub{font-size:14px;line-height:1.6;color:#888;margin-bottom:32px}
.name-input-group{margin-bottom:32px}
.name-label{display:block;font-size:12px;letter-spacing:.08em;color:#666;margin-bottom:8px}
.name-input{width:100%;padding:16px 20px;background:#111;border:1px solid #2a2a2a;border-radius:12px;color:#e8e8e8;font-family:'DM Mono',monospace;font-size:14px;outline:none;transition:border-color .2s}
.name-input:focus{border-color:#00ff88}
.name-input::placeholder{color:#555}
.start-btn{padding:16px 32px;background:#00ff88;color:#000;font-family:'DM Mono',monospace;font-weight:500;font-size:14px;letter-spacing:.08em;border:none;border-radius:100px;cursor:pointer;transition:opacity .2s,transform .2s}
.start-btn:hover{opacity:.85;transform:scale(1.02)}
.start-btn:disabled{opacity:.3;cursor:not-allowed}
.loading-bar{margin-top:24px;height:2px;background:#1a1a1a;border-radius:1px;overflow:hidden;opacity:0;transition:opacity .3s}
.loading-bar.active{opacity:1}
.loading-bar-fill{height:100%;background:#00ff88;width:0%;transition:width .3s}

header{position:fixed;top:0;left:0;right:0;height:56px;display:flex;align-items:center;justify-content:space-between;padding:0 24px;background:rgba(10,10,10,.85);backdrop-filter:blur(12px);border-bottom:1px solid #1f1f1f;z-index:10}
.logo{font-family:'Syne',sans-serif;font-weight:800;font-size:18px;letter-spacing:.08em;color:#fff}
.logo span{color:#00ff88}
.header-right{display:flex;align-items:center;gap:20px}
.nav-btn{color:#888;font-size:12px;letter-spacing:.06em;background:transparent;border:1px solid #2a2a2a;border-radius:100px;padding:6px 16px;cursor:pointer;font-family:'DM Mono',monospace;transition:color .2s,border-color .2s}
.nav-btn:hover{color:#00ff88;border-color:#00ff88}
.status-pill{display:flex;align-items:center;gap:8px;padding:6px 12px;background:#111;border:1px solid #2a2a2a;border-radius:100px}
.status-dot{width:6px;height:6px;border-radius:50%;background:#555;transition:background .3s}
.status-pill.active .status-dot{background:#00ff88}
#status-text{font-size:10px;letter-spacing:.12em;color:#666;transition:color .3s}
.status-pill.active #status-text{color:#00ff88}

main{display:flex;height:100vh;padding-top:56px}
.camera-area{flex:1;display:flex}
.viewport{flex:1;position:relative;display:flex;align-items:center;justify-content:center;background:#000;overflow:hidden}
#video{width:100%;height:100%;object-fit:cover;transform:scaleX(-1)}
.face-guide{position:absolute;display:flex;flex-direction:column;align-items:center;gap:20px;pointer-events:none}
.face-oval{position:relative;width:260px;height:320px;border:2px solid rgba(255,255,255,.2);border-radius:50%;transition:border-color .3s,box-shadow .3s}
.face-oval.ready{border-color:#00ff88;box-shadow:0 0 24px rgba(0,255,136,.25)}
.face-oval.no-face{border-color:rgba(255,255,255,.15)}
.face-oval.partial{border-color:#f59e0b;box-shadow:0 0 16px rgba(245,158,11,.2)}
.bracket{position:absolute;width:20px;height:20px;border:2px solid #00ff88;transition:opacity .3s}
.bracket.tl{top:-2px;left:-2px;border-right:none;border-bottom:none}
.bracket.tr{top:-2px;right:-2px;border-left:none;border-bottom:none}
.bracket.bl{bottom:-2px;left:-2px;border-right:none;border-top:none}
.bracket.br{bottom:-2px;right:-2px;border-left:none;border-top:none}
.face-status{font-size:13px;letter-spacing:.06em;color:#888;text-align:center;padding:10px 20px;background:rgba(0,0,0,.65);border-radius:100px;backdrop-filter:blur(8px);transition:color .3s;pointer-events:none}
.face-status.ready{color:#00ff88}
.face-status.partial{color:#f59e0b}

.capture-btn{position:absolute;bottom:32px;left:50%;transform:translateX(-50%);display:flex;align-items:center;gap:10px;padding:14px 32px;background:#00ff88;color:#000;font-family:'DM Mono',monospace;font-weight:600;font-size:14px;letter-spacing:.08em;border:none;border-radius:100px;cursor:pointer;transition:opacity .25s,transform .25s,box-shadow .25s;box-shadow:0 4px 24px rgba(0,255,136,.35);white-space:nowrap}
.capture-btn:hover:not(:disabled){opacity:.9;transform:translateX(-50%) scale(1.04);box-shadow:0 6px 32px rgba(0,255,136,.5)}
.capture-btn:disabled{background:#1a1a1a;color:#444;box-shadow:none;cursor:not-allowed}
.capture-btn-icon{font-size:18px}

.controls{width:320px;min-width:260px;padding:24px;border-left:1px solid #1a1a1a;display:flex;flex-direction:column;gap:24px;overflow-y:auto}
.capture-info{padding:20px;background:#111;border:1px solid #1f1f1f;border-radius:12px}
.info-title{font-family:'Syne',sans-serif;font-weight:700;font-size:15px;letter-spacing:.04em;margin-bottom:8px}
.info-desc{font-size:12px;line-height:1.6;color:#888}

.indicators{display:flex;flex-direction:column;gap:12px;padding:20px;background:#111;border:1px solid #1f1f1f;border-radius:12px}
.indicator{display:flex;align-items:center;gap:10px;font-size:13px;color:#666;transition:color .3s}
.indicator.ok{color:#00ff88}
.indicator.fail{color:#ef4444}
.ind-dot{width:8px;height:8px;border-radius:50%;background:#333;transition:background .3s}
.indicator.ok .ind-dot{background:#00ff88}
.indicator.fail .ind-dot{background:#ef4444}

/* Modal Colección */
.modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.8);backdrop-filter:blur(8px);z-index:200;display:none;align-items:center;justify-content:center}
.modal-overlay.open{display:flex}
.modal{background:#111;border:1px solid #2a2a2a;border-radius:16px;width:90vw;max-width:800px;max-height:85vh;display:flex;flex-direction:column;overflow:hidden}
.modal-header{display:flex;align-items:center;justify-content:space-between;padding:20px 24px;border-bottom:1px solid #1f1f1f}
.modal-header h2{font-family:'Syne',sans-serif;font-weight:700;font-size:18px;margin:0;color:#fff}
.modal-close{background:none;border:none;color:#666;font-size:24px;cursor:pointer;transition:color .2s}
.modal-close:hover{color:#fff}
.modal-body{padding:24px;overflow-y:auto;flex:1}
.carousel-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:16px}
.carousel-item{position:relative;border-radius:10px;overflow:hidden;border:1px solid #2a2a2a;cursor:pointer;transition:border-color .2s,transform .2s}
.carousel-item:hover{border-color:#00ff88;transform:scale(1.03)}
.carousel-item img{width:100%;aspect-ratio:1;object-fit:cover;display:block}
.carousel-item .ci-name{position:absolute;bottom:0;left:0;right:0;padding:6px 8px;background:rgba(0,0,0,.7);font-size:11px;color:#ccc;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.carousel-item .ci-del{position:absolute;top:6px;right:6px;background:rgba(239,68,68,.85);border:none;color:#fff;width:24px;height:24px;border-radius:50%;font-size:12px;cursor:pointer;display:none;align-items:center;justify-content:center}
.carousel-item:hover .ci-del{display:flex}
.empty-state{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;height:200px;color:#444;font-size:12px;text-align:center}
.empty-state .icon{font-size:28px;color:#333}

/* Lightbox */
.lightbox-overlay{position:fixed;inset:0;background:rgba(0,0,0,.95);z-index:300;display:none;align-items:center;justify-content:center;flex-direction:column}
.lightbox-overlay.open{display:flex}
.lb-close{position:absolute;top:20px;right:24px;background:none;border:none;color:#999;font-size:32px;cursor:pointer;z-index:2}
.lb-close:hover{color:#fff}
.lb-nav{position:absolute;top:50%;transform:translateY(-50%);background:rgba(255,255,255,.1);border:none;color:#fff;font-size:36px;width:48px;height:48px;border-radius:50%;cursor:pointer;transition:background .2s;z-index:2}
.lb-nav:hover{background:rgba(255,255,255,.2)}
.lb-prev{left:24px}
.lb-next{right:24px}
.lb-content{text-align:center}
#lb-img{max-width:80vw;max-height:70vh;border-radius:12px;border:2px solid #2a2a2a}
.lb-info{margin-top:12px;font-size:14px;color:#aaa}
.lb-delete{position:absolute;bottom:24px;padding:10px 24px;background:#ef4444;color:#fff;border:none;border-radius:100px;font-family:'DM Mono',monospace;font-size:13px;cursor:pointer;transition:opacity .2s}
.lb-delete:hover{opacity:.8}

@media(max-width:768px){
  .camera-area{flex-direction:column}
  .controls{width:100%;min-width:unset;border-left:none;border-top:1px solid #1a1a1a;max-height:35vh}
  .face-oval{width:200px;height:260px}
  .capture-btn{bottom:20px;padding:12px 24px;font-size:13px}
}
</style>

<script type="module">
// ── Elements ──────────────────────────────────────────────────────────────────
const startScreen = document.getElementById('start-screen');
const personNameInput = document.getElementById('person-name');
const startBtn = document.getElementById('start-btn');
const loadingBar = document.getElementById('loading-bar');
const video = document.getElementById('video');
const canvas = document.getElementById('canvas');
const statusPill = document.getElementById('status-pill');
const statusText = document.getElementById('status-text');
const faceStatus = document.getElementById('face-status');
const faceOval = document.getElementById('face-oval');
const captureBtn = document.getElementById('capture-btn');
const collectionBtn = document.getElementById('collection-btn');
const modalOverlay = document.getElementById('modal-overlay');
const modalClose = document.getElementById('modal-close');
const modalBody = document.getElementById('modal-body');
const lightboxOverlay = document.getElementById('lightbox-overlay');
const lbImg = document.getElementById('lb-img');
const lbInfo = document.getElementById('lb-info');
const lbClose = document.getElementById('lb-close');
const lbPrev = document.getElementById('lb-prev');
const lbNext = document.getElementById('lb-next');
const lbDelete = document.getElementById('lb-delete');
const indFace = document.getElementById('ind-face');
const indEyes = document.getElementById('ind-eyes');
const indMouth = document.getElementById('ind-mouth');

// ── State ─────────────────────────────────────────────────────────────────────
let stream = null;
let ws = null;
let faceReady = false;
let currentName = '';
let analyzing = false;
let photos = [];
let lbIndex = 0;

// ── Start ─────────────────────────────────────────────────────────────────────
startBtn.addEventListener('click', async () => {
  const name = personNameInput.value.trim();
  if (!name) { alert('Por favor, ingresá un nombre'); return; }
  currentName = name;
  startBtn.disabled = true;
  startBtn.textContent = 'Iniciando cámara...';
  loadingBar.classList.add('active');
  loadingBar.querySelector('.loading-bar-fill').style.width = '50%';

  try {
    stream = await navigator.mediaDevices.getUserMedia({
      video: { width: { ideal: 1280 }, height: { ideal: 720 }, facingMode: 'user' }
    });
    video.srcObject = stream;
    await new Promise(r => { video.onloadedmetadata = r; });
    canvas.width = video.videoWidth;
    canvas.height = video.videoHeight;
    loadingBar.querySelector('.loading-bar-fill').style.width = '100%';

    setTimeout(() => {
      startScreen.style.display = 'none';
      statusPill.classList.add('active');
      statusText.textContent = 'ACTIVO';
      connectWS();
    }, 300);
  } catch (e) {
    alert('Error al iniciar cámara: ' + e.message);
    startBtn.disabled = false;
    startBtn.textContent = 'Iniciar cámara';
    loadingBar.classList.remove('active');
  }
});

// ── WebSocket ─────────────────────────────────────────────────────────────────
function connectWS() {
  const proto = location.protocol === 'https:' ? 'wss' : 'ws';
  ws = new WebSocket(`${proto}://${location.host}/ws/analyze`);
  ws.onopen = () => { console.log('WS conectado'); startAnalysis(); };
  ws.onmessage = (e) => {
    analyzing = false;
    const r = JSON.parse(e.data);
    if (r.error) return;
    updateIndicators(r);
    faceReady = r.ready === true;
    updateFaceUI(r);
  };
  ws.onclose = () => { setTimeout(connectWS, 2000); };
  ws.onerror = () => { ws.close(); };
}

function startAnalysis() {
  setInterval(() => {
    if (!ws || ws.readyState !== 1 || analyzing) return;
    analyzing = true;
    const ctx = canvas.getContext('2d');
    ctx.drawImage(video, 0, 0);
    const dataUrl = canvas.toDataURL('image/jpeg', 0.5);
    ws.send(dataUrl);
  }, 250); // ~4fps — MediaPipe es rápido
}

function updateIndicators(r) {
  indFace.className = 'indicator ' + (r.face_detected ? 'ok' : 'fail');
  indEyes.className = 'indicator ' + (r.eyes_open ? 'ok' : 'fail');
  indMouth.className = 'indicator ' + (r.mouth_closed ? 'ok' : 'fail');
  // Debug: mostrar valores de blendshapes
  if (r.blink_l !== undefined) {
    indEyes.title = `L:${r.blink_l} R:${r.blink_r}`;
    indMouth.title = `jaw:${r.jaw_open}`;
  }
}

function updateFaceUI(r) {
  if (r.ready) {
    faceOval.className = 'face-oval ready';
    faceStatus.textContent = '✓ Rostro listo — presioná el botón';
    faceStatus.className = 'face-status ready';
    captureBtn.disabled = false;
  } else if (r.face_detected) {
    faceOval.className = 'face-oval partial';
    let msg = [];
    if (!r.eyes_open) msg.push('abrí los ojos');
    if (!r.mouth_closed) msg.push('cerrá la boca');
    faceStatus.textContent = msg.length ? msg.join(' y ') : 'Ajustá posición';
    faceStatus.className = 'face-status partial';
    captureBtn.disabled = true;
  } else {
    faceOval.className = 'face-oval no-face';
    faceStatus.textContent = 'Posicioná tu rostro';
    faceStatus.className = 'face-status';
    captureBtn.disabled = true;
  }
}

// ── Captura ───────────────────────────────────────────────────────────────────
captureBtn.addEventListener('click', async () => {
  if (!faceReady) return;
  captureBtn.disabled = true;
  captureBtn.querySelector('.capture-btn-label').textContent = 'Guardando...';

  try {
    const ctx = canvas.getContext('2d');
    ctx.drawImage(video, 0, 0);
    const imgData = canvas.toDataURL('image/jpeg', 0.92);

    const resp = await fetch('/api/photos', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name: currentName, image: imgData }),
    });
    const result = await resp.json();
    if (result.ok) {
      faceStatus.textContent = '✓ Foto guardada en MongoDB';
      faceStatus.className = 'face-status ready';
      setTimeout(() => { faceReady = false; updateFaceUI({ face_detected: false }); }, 1500);
    } else {
      faceStatus.textContent = 'Error: ' + (result.error || 'desconocido');
      faceStatus.className = 'face-status';
    }
  } catch (e) {
    faceStatus.textContent = 'Error de red';
    faceStatus.className = 'face-status';
  } finally {
    captureBtn.querySelector('.capture-btn-label').textContent = 'Tomar foto';
  }
});

// ── Colección ─────────────────────────────────────────────────────────────────
collectionBtn.addEventListener('click', async () => {
  modalOverlay.classList.add('open');
  await loadPhotos();
});
modalClose.addEventListener('click', () => modalOverlay.classList.remove('open'));
modalOverlay.addEventListener('click', (e) => { if (e.target === modalOverlay) modalOverlay.classList.remove('open'); });

async function loadPhotos() {
  try {
    const resp = await fetch('/api/photos');
    const data = await resp.json();
    photos = data.photos || [];
    renderGallery();
  } catch (e) {
    modalBody.innerHTML = '<div class="empty-state"><span class="icon">⚠</span>Error cargando fotos</div>';
  }
}

function renderGallery() {
  if (!photos.length) {
    modalBody.innerHTML = '<div class="empty-state"><span class="icon">◎</span>No hay fotos aún</div>';
    return;
  }
  modalBody.innerHTML = '<div class="carousel-grid" id="carousel-grid"></div>';
  const grid = document.getElementById('carousel-grid');
  photos.forEach((p, i) => {
    const item = document.createElement('div');
    item.className = 'carousel-item';
    const dateStr = new Date(p.captured_at).toLocaleDateString('es-AR', { day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit' });
    item.innerHTML = `<img src="${p.photo_data}" alt="${p.name}"/><div class="ci-name">${p.name} — ${dateStr}</div><button class="ci-del" data-id="${p._id}">✕</button>`;
    item.querySelector('img').addEventListener('click', () => openLightbox(i));
    item.querySelector('.ci-del').addEventListener('click', (e) => { e.stopPropagation(); deletePhoto(p._id); });
    grid.appendChild(item);
  });
}

// ── Lightbox ──────────────────────────────────────────────────────────────────
function openLightbox(index) {
  lbIndex = index;
  showLightboxPhoto();
  lightboxOverlay.classList.add('open');
}

function showLightboxPhoto() {
  const p = photos[lbIndex];
  if (!p) return;
  lbImg.src = p.photo_data;
  const d = new Date(p.captured_at).toLocaleString('es-AR');
  lbInfo.textContent = `${p.name} — ${d} — 4cm × 4cm`;
  lbDelete.dataset.id = p._id;
}

lbClose.addEventListener('click', () => lightboxOverlay.classList.remove('open'));
lightboxOverlay.addEventListener('click', (e) => { if (e.target === lightboxOverlay) lightboxOverlay.classList.remove('open'); });
lbPrev.addEventListener('click', () => { lbIndex = (lbIndex - 1 + photos.length) % photos.length; showLightboxPhoto(); });
lbNext.addEventListener('click', () => { lbIndex = (lbIndex + 1) % photos.length; showLightboxPhoto(); });
lbDelete.addEventListener('click', async () => {
  const id = lbDelete.dataset.id;
  if (!confirm('¿Eliminar esta foto?')) return;
  await deletePhoto(id);
  lightboxOverlay.classList.remove('open');
});

async function deletePhoto(id) {
  try {
    await fetch(`/api/photos/${id}`, { method: 'DELETE' });
    await loadPhotos();
  } catch (e) {
    alert('Error al eliminar');
  }
}

// Cleanup
window.addEventListener('beforeunload', () => { if (stream) stream.getTracks().forEach(t => t.stop()); if (ws) ws.close(); });
</script>
