---
import Layout from '../layouts/Layout.astro';
---

<Layout title="FaceCapture — Comparar">
  <header>
    <a href="/" class="back-link">← Captura</a>
    <div class="logo">FACE<span>CAPTURE</span></div>
    <div class="header-right">
      <button class="clear-btn" id="clear-db-btn" title="Borrar base de datos">🗑 Borrar DB</button>
      <div class="page-label">COMPARAR</div>
    </div>
  </header>

  <main>
    <!-- Panel izquierdo: webcam -->
    <div class="cam-panel">
      <div class="panel-title">Tu rostro</div>

      <div class="viewport" id="viewport">
        <video id="video" autoplay muted playsinline></video>
        <canvas id="snap-canvas" style="display:none"></canvas>

        <!-- Óvalo guía -->
        <div class="face-guide">
          <div class="face-oval" id="face-oval">
            <div class="bracket tl"></div>
            <div class="bracket tr"></div>
            <div class="bracket bl"></div>
            <div class="bracket br"></div>
          </div>
          <div class="face-status" id="face-status">Iniciando cámara…</div>
        </div>

        <!-- Botón comparar flotante -->
        <button class="compare-btn" id="compare-btn" disabled>
          <span class="compare-btn-icon">⟳</span>
          <span class="compare-btn-label">Comparar</span>
        </button>
      </div>

      <div class="result-status" id="result-status"></div>
    </div>

    <!-- Panel derecho: resultados -->
    <div class="results-panel">
      <div class="panel-title">Resultados</div>
      <div class="results-list" id="results-list">
        <div class="empty-state">
          <span class="icon">◎</span>
          Mirá a la cámara y presioná<br /><strong>Comparar</strong> para buscar coincidencias
        </div>
      </div>
    </div>
  </main>
</Layout>

<style>
  * { box-sizing: border-box; }

  body {
    margin: 0;
    font-family: 'DM Mono', monospace;
    background: #0a0a0a;
    color: #e8e8e8;
    overflow: hidden;
  }

  /* ── Header ────────────────────────────────────────────────────────── */
  header {
    position: fixed;
    top: 0; left: 0; right: 0;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 24px;
    background: rgba(10,10,10,0.85);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid #1f1f1f;
    z-index: 10;
  }

  .back-link {
    color: #888;
    font-size: 12px;
    letter-spacing: 0.06em;
    text-decoration: none;
    transition: color 0.2s;
  }
  .back-link:hover { color: #00ff88; }

  .logo {
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    font-size: 18px;
    letter-spacing: 0.08em;
    color: #fff;
  }
  .logo span { color: #00ff88; }

  .page-label {
    font-size: 10px;
    letter-spacing: 0.14em;
    color: #555;
    padding: 4px 12px;
    border: 1px solid #2a2a2a;
    border-radius: 100px;
  }

  .header-right { display: flex; align-items: center; gap: 12px; }

  .clear-btn {
    padding: 5px 12px;
    background: transparent;
    border: 1px solid #2a2a2a;
    border-radius: 100px;
    color: #666;
    font-family: 'DM Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.06em;
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s;
  }
  .clear-btn:hover { border-color: #ef4444; color: #ef4444; }

  /* ── Layout ─────────────────────────────────────────────────────────── */
  main {
    display: flex;
    height: 100vh;
    padding-top: 56px;
  }

  /* ── Cam panel ──────────────────────────────────────────────────────── */
  .cam-panel {
    width: 420px;
    min-width: 340px;
    padding: 24px;
    border-right: 1px solid #1a1a1a;
    display: flex;
    flex-direction: column;
    gap: 16px;
    overflow: hidden;
  }

  .panel-title {
    font-family: 'Syne', sans-serif;
    font-weight: 700;
    font-size: 15px;
    letter-spacing: 0.04em;
    flex-shrink: 0;
  }

  .viewport {
    position: relative;
    flex: 1;
    border-radius: 14px;
    overflow: hidden;
    background: #000;
    min-height: 0;
  }

  #video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scaleX(-1);
    display: block;
  }

  /* ── Face guide ─────────────────────────────────────────────────────── */
  .face-guide {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    pointer-events: none;
  }

  .face-oval {
    position: relative;
    width: 180px;
    height: 220px;
    border: 2px solid rgba(255,255,255,0.2);
    border-radius: 50%;
    transition: border-color 0.3s, box-shadow 0.3s;
  }
  .face-oval.ready {
    border-color: #00ff88;
    box-shadow: 0 0 20px rgba(0,255,136,0.3);
  }

  .bracket {
    position: absolute;
    width: 16px; height: 16px;
    border: 2px solid #00ff88;
  }
  .bracket.tl { top: -2px; left: -2px; border-right: none; border-bottom: none; }
  .bracket.tr { top: -2px; right: -2px; border-left: none; border-bottom: none; }
  .bracket.bl { bottom: -2px; left: -2px; border-right: none; border-top: none; }
  .bracket.br { bottom: -2px; right: -2px; border-left: none; border-top: none; }

  .face-status {
    font-size: 12px;
    letter-spacing: 0.06em;
    color: #888;
    text-align: center;
    padding: 8px 16px;
    background: rgba(0,0,0,0.65);
    border-radius: 100px;
    backdrop-filter: blur(8px);
    transition: color 0.3s;
  }
  .face-status.ready { color: #00ff88; }

  /* ── Compare button ─────────────────────────────────────────────────── */
  .compare-btn {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 28px;
    background: #00ff88;
    color: #000;
    font-family: 'DM Mono', monospace;
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 0.08em;
    border: none;
    border-radius: 100px;
    cursor: pointer;
    white-space: nowrap;
    transition: opacity 0.2s, transform 0.2s, box-shadow 0.2s;
    box-shadow: 0 4px 20px rgba(0,255,136,0.3);
  }
  .compare-btn:hover:not(:disabled) {
    opacity: 0.9;
    transform: translateX(-50%) scale(1.04);
  }
  .compare-btn:disabled {
    background: #1a1a1a;
    color: #444;
    box-shadow: none;
    cursor: not-allowed;
  }
  .compare-btn.loading {
    background: #111;
    color: #00ff88;
    border: 1px solid #2a2a2a;
  }
  .compare-btn-icon { font-size: 16px; }

  .result-status {
    font-size: 11px;
    letter-spacing: 0.08em;
    color: #555;
    text-align: center;
    min-height: 18px;
    flex-shrink: 0;
  }

  /* ── Results panel ──────────────────────────────────────────────────── */
  .results-panel {
    flex: 1;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    overflow: hidden;
  }

  .results-list {
    flex: 1;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 12px;
    scrollbar-width: thin;
    scrollbar-color: #2a2a2a transparent;
  }

  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    height: 100%;
    color: #444;
    font-size: 12px;
    text-align: center;
    line-height: 1.8;
  }
  .empty-state .icon { font-size: 32px; color: #333; }
  .empty-state strong { color: #666; }

  /* ── Result cards ───────────────────────────────────────────────────── */
  .result-card {
    display: flex;
    gap: 16px;
    padding: 16px;
    background: #111;
    border: 1px solid #1f1f1f;
    border-radius: 12px;
    transition: border-color 0.2s;
    animation: fadeIn 0.25s ease;
  }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  .result-card.match   { border-color: rgba(0,255,136,0.4); }
  .result-card.no-match { border-color: rgba(239,68,68,0.25); }

  .result-thumb {
    width: 80px; height: 60px;
    border-radius: 8px;
    object-fit: cover;
    flex-shrink: 0;
  }

  .result-info {
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1;
    min-width: 0;
  }

  .result-name {
    font-family: 'Syne', sans-serif;
    font-weight: 700;
    font-size: 14px;
    color: #e8e8e8;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .result-score {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .score-bar {
    flex: 1;
    height: 4px;
    background: #1f1f1f;
    border-radius: 2px;
    overflow: hidden;
  }
  .score-bar-fill {
    height: 100%;
    border-radius: 2px;
    transition: width 0.5s ease;
  }
  .score-bar-fill.high   { background: #00ff88; }
  .score-bar-fill.medium { background: #f59e0b; }
  .score-bar-fill.low    { background: #ef4444; }

  .score-val {
    font-size: 12px;
    font-weight: 500;
    min-width: 40px;
    text-align: right;
  }
  .score-val.high   { color: #00ff88; }
  .score-val.medium { color: #f59e0b; }
  .score-val.low    { color: #ef4444; }

  .result-label {
    font-size: 10px;
    letter-spacing: 0.1em;
    color: #555;
  }

  .no-face-msg {
    padding: 20px;
    text-align: center;
    color: #ef4444;
    font-size: 12px;
    letter-spacing: 0.05em;
    border: 1px solid rgba(239,68,68,0.2);
    border-radius: 12px;
    background: rgba(239,68,68,0.05);
  }

  /* ── Responsive ──────────────────────────────────────────────────────── */
  @media (max-width: 768px) {
    body { overflow: auto; }
    main { flex-direction: column; height: auto; overflow: auto; }
    .cam-panel { width: 100%; min-width: unset; border-right: none; border-bottom: 1px solid #1a1a1a; height: 60vh; }
    .results-panel { min-height: 50vh; }
  }
</style>

<script type="module">
import {
  FaceLandmarker,
  FilesetResolver,
} from 'https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.18/+esm';
import { supabase, clearDatabase } from '/lib/database.js';

// ── Elements ──────────────────────────────────────────────────────────────────
const video       = document.getElementById('video');
const snapCanvas  = document.getElementById('snap-canvas');
const faceOval    = document.getElementById('face-oval');
const faceStatus  = document.getElementById('face-status');
const compareBtn  = document.getElementById('compare-btn');
const resultsList = document.getElementById('results-list');
const resultStatus = document.getElementById('result-status');

// ── State ─────────────────────────────────────────────────────────────────────
let faceLandmarker = null;
let stream         = null;
let faceReady      = false;
let isDetecting    = false;

// ── Boot ──────────────────────────────────────────────────────────────────────
async function boot() {
  try {
    faceStatus.textContent = 'Cargando modelo…';
    await startCamera();
    await loadModel();
    faceStatus.textContent = 'Posicioná tu rostro';
    isDetecting = true;
    detectLoop();
  } catch (err) {
    console.error('Error al iniciar:', err);
    faceStatus.textContent = 'Error: ' + err.message;
  }
}

boot();

// ── Cámara ────────────────────────────────────────────────────────────────────
async function startCamera() {
  stream = await navigator.mediaDevices.getUserMedia({
    video: { width: { ideal: 1280 }, height: { ideal: 720 }, facingMode: 'user' }
  });
  video.srcObject = stream;
  await new Promise(r => { video.onloadedmetadata = r; });
  snapCanvas.width  = video.videoWidth;
  snapCanvas.height = video.videoHeight;
}

// ── MediaPipe ─────────────────────────────────────────────────────────────────
async function loadModel() {
  const vision = await FilesetResolver.forVisionTasks(
    'https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.18/wasm'
  );
  faceLandmarker = await FaceLandmarker.createFromOptions(vision, {
    baseOptions: {
      modelAssetPath: 'https://storage.googleapis.com/mediapipe-models/face_landmarker/face_landmarker/float16/1/face_landmarker.task',
      delegate: 'GPU'
    },
    outputFaceBlendshapes: true,
    runningMode: 'VIDEO',
    numFaces: 1,
    minFaceDetectionConfidence: 0.6,
    minFacePresenceConfidence: 0.6,
    minTrackingConfidence: 0.6,
  });
}

// ── Detección continua ────────────────────────────────────────────────────────
const EYE_BLINK_THRESHOLD = 0.35;

function eyesOpen(blendshapes) {
  if (!blendshapes?.length) return false;
  const cats = blendshapes[0].categories;
  const blinkL = cats.find(c => c.categoryName === 'eyeBlinkLeft')?.score  ?? 1;
  const blinkR = cats.find(c => c.categoryName === 'eyeBlinkRight')?.score ?? 1;
  return blinkL < EYE_BLINK_THRESHOLD && blinkR < EYE_BLINK_THRESHOLD;
}

function detectLoop() {
  if (!isDetecting || !faceLandmarker) return;

  const res  = faceLandmarker.detectForVideo(video, performance.now());
  const face = res.faceLandmarks?.length > 0;
  const open = face && eyesOpen(res.faceBlendshapes);
  const ready = face && open;

  if (ready !== faceReady) {
    faceReady = ready;
    if (ready) {
      faceOval.classList.add('ready');
      faceStatus.textContent = '✓ Listo — presioná Comparar';
      faceStatus.className = 'face-status ready';
      compareBtn.disabled = false;
    } else if (face) {
      faceOval.classList.remove('ready');
      faceStatus.textContent = 'Abrí los ojos';
      faceStatus.className = 'face-status';
      compareBtn.disabled = true;
    } else {
      faceOval.classList.remove('ready');
      faceStatus.textContent = 'Posicioná tu rostro';
      faceStatus.className = 'face-status';
      compareBtn.disabled = true;
    }
  }

  requestAnimationFrame(detectLoop);
}

// ── Comparar ──────────────────────────────────────────────────────────────────
compareBtn.addEventListener('click', async () => {
  if (!faceReady) return;

  compareBtn.disabled = true;
  compareBtn.classList.add('loading');
  compareBtn.querySelector('.compare-btn-label').textContent = 'Analizando…';
  resultStatus.textContent = '';

  try {
    // 1. Capturar frame actual de la webcam
    const ctx = snapCanvas.getContext('2d');
    ctx.save();
    ctx.scale(-1, 1);
    ctx.drawImage(video, -snapCanvas.width, 0, snapCanvas.width, snapCanvas.height);
    ctx.restore();

    // 2. Detectar landmarks en el frame capturado
    //    Necesitamos modo IMAGE para una imagen estática
    const visionImg = await FilesetResolver.forVisionTasks(
      'https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.18/wasm'
    );
    const imgLandmarker = await FaceLandmarker.createFromOptions(visionImg, {
      baseOptions: {
        modelAssetPath: 'https://storage.googleapis.com/mediapipe-models/face_landmarker/face_landmarker/float16/1/face_landmarker.task',
        delegate: 'GPU'
      },
      runningMode: 'IMAGE',
      numFaces: 1,
      minFaceDetectionConfidence: 0.5,
    });

    const snapImg = new Image();
    snapImg.src = snapCanvas.toDataURL('image/jpeg', 0.9);
    await new Promise(r => { snapImg.onload = r; });

    const snapResult = imgLandmarker.detect(snapImg);
    imgLandmarker.close();

    if (!snapResult.faceLandmarks?.length) {
      resultsList.innerHTML = '<div class="no-face-msg">No se detectó rostro en el frame. Intentá de nuevo.</div>';
      return;
    }

    const liveLandmarks = snapResult.faceLandmarks[0];

    // 3. Cargar fotos de la base de datos
    const { data: photos, error } = await supabase
      .from('face_photos')
      .select('id, person_id, photo_data, captured_at');

    if (error) throw error;

    if (!photos?.length) {
      resultsList.innerHTML = '<div class="no-face-msg">No hay fotos guardadas. Capturá fotos primero.</div>';
      return;
    }

    // 4. Comparar contra cada foto guardada
    // Crear un landmarker IMAGE reutilizable para las fotos de la DB
    const visionDb = await FilesetResolver.forVisionTasks(
      'https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.18/wasm'
    );
    const dbLandmarker = await FaceLandmarker.createFromOptions(visionDb, {
      baseOptions: {
        modelAssetPath: 'https://storage.googleapis.com/mediapipe-models/face_landmarker/face_landmarker/float16/1/face_landmarker.task',
        delegate: 'GPU'
      },
      runningMode: 'IMAGE',
      numFaces: 1,
      minFaceDetectionConfidence: 0.5,
    });

    const comparisons = [];

    for (const photo of photos) {
      const img = new Image();
      img.src = photo.photo_data;
      await new Promise(r => { img.onload = r; img.onerror = r; });

      const res = dbLandmarker.detect(img);
      if (!res.faceLandmarks?.length) continue;

      const sim = computeSimilarity(liveLandmarks, res.faceLandmarks[0]);
      comparisons.push({
        personName: photo.person_name || 'Desconocido',
        photoData:  photo.photo_data,
        similarity: sim,
      });
    }

    dbLandmarker.close();

    comparisons.sort((a, b) => b.similarity - a.similarity);
    renderResults(comparisons);

    const best = comparisons[0];
    if (best) {
      if (best.similarity >= 70) {
        resultStatus.textContent = `Mejor coincidencia: ${best.personName} (${best.similarity}%)`;
        resultStatus.style.color = '#00ff88';
      } else {
        resultStatus.textContent = 'No se encontró una coincidencia significativa';
        resultStatus.style.color = '#f59e0b';
      }
    }

  } catch (err) {
    console.error(err);
    resultStatus.textContent = 'Error: ' + err.message;
    resultStatus.style.color = '#ef4444';
  } finally {
    compareBtn.classList.remove('loading');
    compareBtn.querySelector('.compare-btn-label').textContent = 'Comparar';
    // Re-habilitar solo si el rostro sigue listo
    compareBtn.disabled = !faceReady;
  }
});

// ── Similitud ─────────────────────────────────────────────────────────────────
function computeSimilarity(landmarksA, landmarksB) {
  let total = 0;
  const n = Math.min(landmarksA.length, landmarksB.length);
  for (let i = 0; i < n; i++) {
    const dx = landmarksA[i].x - landmarksB[i].x;
    const dy = landmarksA[i].y - landmarksB[i].y;
    const dz = (landmarksA[i].z ?? 0) - (landmarksB[i].z ?? 0);
    total += Math.sqrt(dx*dx + dy*dy + dz*dz);
  }
  const avg = total / n;
  return Math.round(Math.max(0, Math.min(100, (1 - avg / 0.15) * 100)));
}

// ── Render ────────────────────────────────────────────────────────────────────
function renderResults(comparisons) {
  if (!comparisons.length) {
    resultsList.innerHTML = '<div class="no-face-msg">No se pudieron extraer rostros de las fotos guardadas.</div>';
    return;
  }

  resultsList.innerHTML = '';
  for (const c of comparisons) {
    const level = c.similarity >= 70 ? 'high' : c.similarity >= 40 ? 'medium' : 'low';
    const card = document.createElement('div');
    card.className = `result-card ${c.similarity >= 70 ? 'match' : 'no-match'}`;
    card.innerHTML = `
      <img class="result-thumb" src="${c.photoData}" alt="${c.personName}" />
      <div class="result-info">
        <div class="result-name">${c.personName}</div>
        <div class="result-score">
          <div class="score-bar"><div class="score-bar-fill ${level}" style="width:${c.similarity}%"></div></div>
          <span class="score-val ${level}">${c.similarity}%</span>
        </div>
        <div class="result-label">${c.similarity >= 70 ? 'COINCIDENCIA ALTA' : c.similarity >= 40 ? 'SIMILITUD PARCIAL' : 'BAJA SIMILITUD'}</div>
      </div>`;
    resultsList.appendChild(card);
  }
}

// ── Cleanup ───────────────────────────────────────────────────────────────────
window.addEventListener('beforeunload', () => {
  if (stream) stream.getTracks().forEach(t => t.stop());
});

// ── Borrar DB ─────────────────────────────────────────────────────────────────
document.getElementById('clear-db-btn').addEventListener('click', async () => {
  if (!confirm('¿Borrar toda la base de datos? Esta acción no se puede deshacer.')) return;
  await clearDatabase();
  resultsList.innerHTML = `
    <div class="empty-state">
      <span class="icon">◎</span>
      Base de datos borrada.<br />Capturá fotos nuevamente.
    </div>`;
  resultStatus.textContent = '';
  alert('Base de datos borrada.');
});
</script>
